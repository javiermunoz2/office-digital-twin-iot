# Copia este fichero como .env y rellena los valores. .env esta en .gitignore.

# PostgreSQL (historico de lecturas para ML y chatbot)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=gemelo_digital

# Exporter / notebook de analisis
TB_URL=http://localhost:8080
TB_USERNAME=tenant@thingsboard.org
TB_PASSWORD=cambia_esta_password
TB_DEVICE_NAME=Sensor_Oficina_simulado
ML_DB_USER=usuario_ml
ML_DB_PASSWORD=cambia_esta_password
ML_DB_HOST=localhost
ML_DB_PORT=5432
ML_DB_NAME=gemelo_datos

# Publisher (simulador): token de acceso del dispositivo en ThingsBoard
MQTT_ACCESS_TOKEN=

# La API key del LLM (Gemini) se configura como credencial dentro de n8n, nunca en el codigo
